[Unit]
Description=SignalForge expired auth data and audit retention cleanup
After=network-online.target

[Service]
Type=oneshot
User=signalforge
Group=signalforge
WorkingDirectory=/opt/signalforge/current
EnvironmentFile=/etc/signalforge/signalforge.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm run auth:cleanup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/signalforge /opt/signalforge/current/tmp
