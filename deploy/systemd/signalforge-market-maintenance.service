[Unit]
Description=Refresh SignalForge trading calendar and daily market data
After=network-online.target signalforge-market-data.service
Wants=network-online.target
Requires=signalforge-market-data.service

[Service]
Type=oneshot
User=signalforge
Group=signalforge
WorkingDirectory=/opt/signalforge/current
EnvironmentFile=/etc/signalforge/signalforge.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm run market:maintain
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/signalforge /opt/signalforge/current/tmp
