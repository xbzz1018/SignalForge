[Unit]
Description=SignalForge durable Data Agent generation worker
After=network-online.target signalforge-market-data.service
Wants=network-online.target
Requires=signalforge-market-data.service

[Service]
Type=simple
User=signalforge
Group=signalforge
WorkingDirectory=/opt/signalforge/current
EnvironmentFile=/etc/signalforge/signalforge.env
Environment=NODE_ENV=production
Environment=PI_AGENT_DISPATCH_MODE=worker
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/env node scripts/checks/check-production-readiness.js
ExecStart=/usr/bin/env npm run worker:generation
Restart=on-failure
RestartSec=5s
TimeoutStopSec=180s
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/signalforge /opt/signalforge/current/tmp /opt/signalforge/current/public/uploads
LimitNOFILE=65536
