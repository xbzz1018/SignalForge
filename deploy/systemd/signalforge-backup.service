[Unit]
Description=Create a verified SignalForge release backup
After=network-online.target

[Service]
Type=oneshot
User=signalforge
Group=signalforge
WorkingDirectory=/opt/signalforge/current
EnvironmentFile=/etc/signalforge/signalforge.env
Environment=SIGNALFORGE_BACKUP_ROOT=/var/backups/signalforge
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm run db:backup:release
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/signalforge /var/lib/signalforge
